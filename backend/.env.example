# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Admin Authentication
JWT_SECRET=taste-the-joy-super-secret-key-2026

# ========================================================
# 🌟 Option A: Connect via Supabase URL & Keys (Recommended)
# ========================================================
# Found in: Supabase Dashboard -> Project Settings -> API
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# (Optional) Service Role Key for bypassing RLS on backend:
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ========================================================
# 🐘 Option B: Direct PostgreSQL Connection String (URI)
# ========================================================
# Found in: Supabase Dashboard -> Project Settings -> Database -> URI
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DB_SSL=true
